# ============================================================
# Gatherly – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Paste values WITHOUT surrounding quotes or extra whitespace.
# ============================================================

# --- AI Providers (server-side only) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override default model names
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Upstash Redis (rate limiting + circuit breaker) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Build Info (set by CI/CD automatically) ---
# NEXT_PUBLIC_BUILD_COMMIT=
